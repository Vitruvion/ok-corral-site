# Instagram (server-side; see docs/instagram-setup.md to obtain).
# Long-lived token, expires in 60 days, must be refreshed before expiry.
# If unset, the InstagramStrip section renders a CTA pointing to the profile.
INSTAGRAM_ACCESS_TOKEN=

# Stripe — TEST mode keys. Switch to live (pk_live_/sk_live_) before launch.
# Used by /api/checkout to create Checkout Sessions.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY is currently unused (checkout is a
# server-side redirect to Stripe's hosted page, no Stripe.js on the client).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx

# Stripe webhook signing secret for /api/stripe/webhook (starts whsec_).
# REQUIRED for merch orders to ever be marked paid — without it the route
# returns 500 and refuses to trust the payload.
#   local dev:  run `stripe listen --forward-to localhost:3050/api/stripe/webhook`
#               and copy the whsec_ it prints
#   production: Stripe Dashboard → Developers → Webhooks → your endpoint →
#               "Signing secret"
# The local and production secrets are DIFFERENT.
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Resend — for booking inquiry email notifications.
# When RESEND_API_KEY is unset, /api/booking-notify silently no-ops; the form
# submission still writes to Supabase. Get a key at https://resend.com.
RESEND_API_KEY=
RESEND_FROM_EMAIL=howdy@okcorralsaloon.com
RESEND_TO_EMAIL=howdy@okcorralsaloon.com

# Apple Wallet — for the digital loyalty card (see docs/apple-wallet-setup.md).
# When any of the CERT / KEY / WWDR base64 vars are unset, /api/card/pass
# returns a 503 with a setup hint instead of a signed pass. The Pass Type ID
# and Team ID are public; the cert/key/wwdr should be base64-encoded PEM
# bodies (so they survive Vercel's env-var pipeline without filesystem fiddling).
APPLE_TEAM_ID=552ZY96UV6
APPLE_PASS_TYPE_ID=pass.com.okcorralsaloon.rewards
APPLE_PASS_CERT_PEM_B64=
APPLE_PASS_KEY_PEM_B64=
APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_PEM_B64=

# Admin access (/admin and everything under it).
#
# TWO PASSCODES, ONE FIELD. /admin/login asks for a passcode and works out
# which role it is; nobody picks a role from a menu.
#
# ADMIN_PASSCODE  - full access. The dashboard, menu, shows, tickets, door.
#                   Lands on /admin after signing in. REQUIRED: without it
#                   the login route returns 503 and nobody can get in.
# DOOR_PASSCODE   - /admin/door and its APIs ONLY. Lands straight on the
#                   scanner. OPTIONAL: leave it unset and there is simply no
#                   door role, which is how the site ran before roles existed.
#                   Set it to something DIFFERENT from ADMIN_PASSCODE -- the
#                   point is that the phone on the stool at the door cannot
#                   rewrite the menu or read purchaser emails. If both are set
#                   to the same string, admin wins and the door role is dead
#                   code.
# ADMIN_COOKIE_SECRET - HMAC key for the session cookie. Any long random
#                   string; generate with:
#                     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#                   Rotating it signs everyone out. Neither passcode is ever
#                   stored in the cookie, only a signature over the timestamps
#                   and the role.
ADMIN_PASSCODE=
DOOR_PASSCODE=
ADMIN_COOKIE_SECRET=

# Ticket signing (/api/tickets/checkout, the confirmation email, and the
# Phase 2 door scanner). HMAC-SHA256 key for the signature baked into every
# ticket QR. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# NEVER prefix this NEXT_PUBLIC_. Anyone holding it can mint tickets that pass
# the door's offline authenticity check, which is the entire security boundary
# of the scanner. Rotating it invalidates every ticket already issued -- only
# rotate between shows, never during one.
TICKET_SIGNING_SECRET=
